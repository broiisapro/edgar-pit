# SEC fair access (decision A-2/A-3): the User-Agent sent with every SEC request.
# Format "Name email" is required for live requests; change this before using live mode.
SEC_USER_AGENT="Your Name your@email"

# Location of the built DuckDB database.
EDGARPIT_DB=/tmp/ep/edgarpit.duckdb

# Client-side request rate limit, 0 < x <= 5 requests per second.
EDGARPIT_RATE_LIMIT_RPS=5
