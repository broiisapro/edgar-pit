# SEC fair access (decisions A-2 and A-3): the User-Agent sent with every SEC
# request. Must be "Name email"; required for live requests, never for offline
# builds. Replace the example with your own name and contact address.
SEC_USER_AGENT="Your Name you@example.com"

# Location of the built DuckDB database read by the CLI, the API and the
# explorer. When the file is missing, the explorer falls back to EDGARPIT_DB_URL.
EDGARPIT_DB=/tmp/ep/edgarpit.duckdb

# Client-side request rate limit in requests per second; 0 < x <= 5.
EDGARPIT_RATE_LIMIT_RPS=5

# Explorer download mode: HTTPS URL of the released edgarpit.duckdb asset,
# used when EDGARPIT_DB is unset or missing. On Streamlit Community Cloud put
# this key at the root of the app's secrets so it is also an environment
# variable.
# EDGARPIT_DB_URL=https://github.com/broiisapro/edgar-pit/releases/download/v1.0.0/edgarpit.duckdb

# Optional SHA-256 (64 hex characters) of that database; a download whose
# digest differs is rejected and the cached file is not used.
# EDGARPIT_DB_SHA256=<64 hex characters>
